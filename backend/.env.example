# Copy this file to .env and fill in your own values.
# .env is ignored by git, so your passwords never get pushed.

# --- Flask ---
FLASK_DEBUG=true
PORT=5000

# --- MySQL / MariaDB (XAMPP defaults: user "root", empty password, port 3306) ---
# If your XAMPP MariaDB runs on another port (e.g. 3307), put it here.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=j_eats

# --- Frontend allowed to call this API (CORS). Comma-separate several. ---
FRONTEND_ORIGINS=http://localhost:3000

# --- Login tokens (JWT) ---
# Required: a random string of 32+ characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# With FLASK_DEBUG=true and no secret, a temporary one is used (everyone is
# signed out when the API restarts). With FLASK_DEBUG=false the API refuses to start.
JWT_SECRET=
# How long a sign-in lasts, in minutes (default 8 hours).
JWT_EXPIRES_MINUTES=480

# --- Verification document uploads (stored in backend/uploads/, never committed) ---
MAX_DOCUMENT_MB=5

# --- Not used yet (payments, AI). Leave as-is for now. ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GEMINI_API_KEY=
