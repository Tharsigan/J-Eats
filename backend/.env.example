# Copy this file to .env and fill in your own values.
# .env is ignored by git, so your passwords never get pushed.

# --- Flask ---
FLASK_DEBUG=true
PORT=5000

# --- MySQL (XAMPP defaults: user "root", empty password, port 3306) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=j_eats

# --- Frontend allowed to call this API (CORS). Comma-separate several. ---
FRONTEND_ORIGINS=http://localhost:3000

# --- Used in Phase 2 (login tokens, payments, AI). Leave as-is for now. ---
JWT_SECRET=change-me-to-a-long-random-string
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GEMINI_API_KEY=
